<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="/css/features.css">
</head>
<body class="auth-body">
  <div class="auth-card">
    <h2>Login</h2>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form action="/login" method="POST">
      <input type="email" name="email" placeholder="Email" value="<%= form.email || '' %>" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit" class="green-btn full">Login</button>
    </form>
    <p class="auth-switch">Account nahi hai? <a href="/signup">Sign up</a></p>
    <p class="auth-switch"><a href="/">Home par wapas</a></p>
  </div>
</body>
</html>