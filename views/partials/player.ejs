<!-- Add to playlist modal -->
<div class="modal" id="playlist-modal" hidden>
  <div class="modal-box">
    <h3>Playlist mein add karo</h3>
    <% if (currentUser && playlists && playlists.length) { %>
      <select id="playlist-select">
        <% playlists.forEach(function(p) { %>
          <option value="<%= p._id %>"><%= p.name %></option>
        <% }) %>
      </select>
      <div class="modal-actions">
        <button id="modal-add" class="green-btn">Add</button>
        <button id="modal-cancel" class="gray-btn">Cancel</button>
      </div>
    <% } else if (currentUser) { %>
      <p>Abhi koi playlist nahi hai. Pehle <a href="/playlists">playlist banao</a>.</p>
      <div class="modal-actions"><button id="modal-cancel" class="gray-btn">Close</button></div>
    <% } else { %>
      <p>Pehle <a href="/login">login</a> karo.</p>
      <div class="modal-actions"><button id="modal-cancel" class="gray-btn">Close</button></div>
    <% } %>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- Player bar -->
<div class="player-bar">
  <div class="player-song">
    <img id="p-img" src="" alt="" hidden>
    <div>
      <div id="p-title" class="p-title">Koi song nahi chal raha</div>
      <div id="p-artist" class="p-artist"></div>
    </div>
  </div>
  <div class="player-center">
    <div class="player-controls">
      <button id="p-prev" title="Previous">&#9198;</button>
      <button id="p-play" class="play-main" title="Play/Pause">&#9654;</button>
      <button id="p-next" title="Next">&#9197;</button>
    </div>
    <div class="progress-row">
      <span id="p-cur">0:00</span>
      <input type="range" id="p-progress" min="0" max="100" value="0" step="0.1">
      <span id="p-dur">0:00</span>
    </div>
  </div>
  <div class="player-volume">
    <span>&#128266;</span>
    <input type="range" id="p-volume" min="0" max="1" step="0.01" value="0.8">
  </div>
</div>
<script src="/js/player.js"></script>